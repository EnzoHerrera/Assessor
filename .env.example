# Copie para .env e preencha. Nunca commite o .env.

# --- LLMs ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Bancos ---
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
QDRANT_URL=https://seu-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=

# --- Juiz (Jev / Typesafe) ---
TYPESAFE_API_KEY=

# --- Google Calendar ---
# JSON de credenciais OAuth "App para computador" (padrão: gcp-oauth.keys.json na raiz)
GOOGLE_OAUTH_CREDENTIALS=gcp-oauth.keys.json
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
# Opcional: access token avulso (se vazio, usa google-calendar.token.json gerado por autenticar())
GOOGLE_CALENDAR_ACCESS_TOKEN=

# --- Observabilidade (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assessor
